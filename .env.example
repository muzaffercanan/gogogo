# Copy to .env and adjust. docker compose reads .env automatically.

# Where workers deliver notifications. Defaults to the bundled mock provider.
# To use webhook.site, create your own URL there and paste it here:
# PROVIDER_URL=https://webhook.site/<your-uuid>
PROVIDER_URL=http://mock-provider:8080/send

LOG_LEVEL=info

# Tracing (OpenTelemetry, standard variables). Spans go to the bundled Jaeger (UI on
# http://localhost:16686) unless the endpoint is set to an empty value, which turns tracing off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio   # default: parentbased_always_on (every trace)
# OTEL_TRACES_SAMPLER_ARG=0.1

# Delivery attempts a notification gets before it is marked permanently_failed.
MAX_ATTEMPTS=5

# Worker tuning (defaults shown).
# RATE_LIMIT_PER_SECOND=100   # sends each channel starts per second, across all workers
# WORKER_CONCURRENCY=50       # sends of each channel one worker runs at once
# WORKER_PREFETCH=20          # unacknowledged messages of each work queue one worker holds (ADR 0015)
# PRIORITY_WEIGHT_HIGH=6      # shares of high, normal and low while all have messages waiting
# PRIORITY_WEIGHT_NORMAL=3
# PRIORITY_WEIGHT_LOW=1
# PROVIDER_TIMEOUT=10s

# Mock provider behaviour (only used by the mock-provider service).
MOCK_LATENCY=50ms
MOCK_JITTER=50ms
MOCK_REJECT_RATE=0
MOCK_THROTTLE_RATE=0
MOCK_FAILURE_RATE=0
